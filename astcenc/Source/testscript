: version
:
# Double-quoted end marker expands $(version.*) and interprets escapes, so
# use unescaped '.' as "any char" rather than '\.'.
#
$* -version >>~"/EOO/"
/astcenc v$(version.major).$(version.minor).$(version.patch).*(\n)?/
//
/?
/Copyright .c. 2011-.* Arm Limited. All rights reserved./
//
/?
EOO

: help
:
$* -help >- 2>-
